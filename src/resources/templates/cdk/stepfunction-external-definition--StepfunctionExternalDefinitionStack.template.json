,\n            \"States\": {\n              \"calculate damage\": {\n                \"Type\": \"Pass\",\n                \"End\": true\n              }\n            }\n          }\n        ]\n      },\n      \"return\": {\n        \"Type\": \"Pass\",\n        \"End\": true\n      }\n    }\n  }",
