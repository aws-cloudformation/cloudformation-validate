    "Data": "name: DockerInstallationDocument\ndescription: This document installs docker.\nschemaVersion: 1.0\n\nphases:\n  - name: build\n    steps:\n      - name: InstallDocker\n        action: ExecuteBash\n        inputs:\n          commands:\n            - yum update -y && yum install -y docker\n\n  - name: validate\n    steps:\n      - name: CheckVersion\n        action: ExecuteBash\n        inputs:\n          commands:\n            - docker --version",
    "Name": "ImagebuilderStack-Docker",
    "Platform": "Linux",
    "Version": "1.0.2"
   },
   "Metadata": {
    "aws:cdk:path": "ImagebuilderStack/DockerComponenet"
