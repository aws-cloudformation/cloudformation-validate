   "Properties": {
    "Data": "name: GitInstallationDocument\ndescription: This document installs git.\nschemaVersion: 1.0\n\nphases:\n  - name: build\n    steps:\n      - name: InstallGit\n        action: ExecuteBash\n        inputs:\n          commands:\n            - yum update -y && yum install -y git\n\n  - name: validate\n    steps:\n      - name: CheckVersion\n        action: ExecuteBash\n        inputs:\n          commands:\n            - git version",
    "Name": "ImagebuilderStack-Git",
    "Platform": "Linux",
    "Version": "1.0.0"
   },
