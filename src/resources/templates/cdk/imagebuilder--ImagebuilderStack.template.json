    "aws:cdk:path": "ImagebuilderStack/GitComponenet"
   }
  },
  "NodejsComponenet": {
   "Type": "AWS::ImageBuilder::Component",
   "Properties": {
    "Data": "name: NodejsV18InstallationDocument\ndescription: This document installs Node.js v18.\nschemaVersion: 1.0\n\nphases:\n  - name: build\n    steps:\n      - name: NodeInstallation\n        action: ExecuteBash\n        inputs:\n          commands:\n            - yum update -y && yum install -y tar\n            - touch ~/.bashrc\n            - curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.3/install.sh | bash\n            - source ~/.bashrc\n            - nvm install --default 18.18.2\n            - nvm alias default 18.18.2\n\n  - name: validate\n    steps:\n      - name: NodeValidation\n        action: ExecuteBash\n        inputs:\n          commands:\n            - source ~/.bashrc\n            - node -v",
    "Name": "ImagebuilderStack-Nodejs",
    "Platform": "Linux",
    "Version": "1.0.0"
   },
   "Metadata": {
    "aws:cdk:path": "ImagebuilderStack/NodejsComponenet"
   }
  },
  "DockerComponenet": {
   "Type": "AWS::ImageBuilder::Component",
