{
 "Resources": {
  "AppRole": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "lambda.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": "*",
         "Resource": "*"
        }
       ]
      },
      "PolicyName": "AdminAccess"
     }
    ]
   },
   "Metadata": {
    "aws:cdk:path": "DemoStack/AppRole"
   }
  },
  "DataBucket": {
   "Type": "AWS::S3::Bucket",
   "Properties": {
    "AccessControl": "PublicRead",
    "VersioningConfiguration": {
     "Status": "Suspended"
    }
   },
   "Metadata": {
    "aws:cdk:path": "DemoStack/DataBucket"
   }
  },
  "AppFunction": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "exports.handler = async (event) => {\n  return { statusCode: 200, body: \"Hello from demo\" };\n};"
    },
    "Handler": "index.handler",
    "Role": {
     "Fn::GetAtt": [
      "AppRole",
      "Arn"
     ]
    },
    "Runtime": "nodejs20.x",
    "Timeout": 60
   },
   "Metadata": {
    "aws:cdk:path": "DemoStack/AppFunction"
   }
  },
  "DataTable": {
   "Type": "AWS::DynamoDB::Table",
   "Properties": {
    "AttributeDefinitions": [
     {
      "AttributeName": "pk",
      "AttributeType": "S"
     }
    ],
    "BillingMode": "PROVISIONED",
    "KeySchema": [
     {
      "AttributeName": "pk",
      "KeyType": "HASH"
     }
    ],
    "TableName": "demo-data-table"
   },
   "Metadata": {
    "aws:cdk:path": "DemoStack/DataTable"
   }
  },
  "AppSecurityGroup": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "Demo security group with intentional issues",
    "SecurityGroupIngress": [
     {
      "CidrIp": "0.0.0.0/0",
      "FromPort": 22,
      "IpProtocol": "tcp",
      "ToPort": 22
     },
     {
      "CidrIp": "10.0.0.0/8",
      "FromPort": 443,
      "IpProtocol": "tcp",
      "ToPort": 80
     }
    ]
   },
   "Metadata": {
    "aws:cdk:path": "DemoStack/AppSecurityGroup"
   }
  },
  "TaskQueue": {
   "Type": "AWS::SQS::Queue",
   "Properties": {
    "VisibilityTimeout": 10
   },
   "Metadata": {
    "aws:cdk:path": "DemoStack/TaskQueue"
   }
  },
  "QueueMapping": {
   "Type": "AWS::Lambda::EventSourceMapping",
   "Properties": {
    "EventSourceArn": {
     "Fn::GetAtt": [
      "TaskQueue",
      "Arn"
     ]
    },
    "FunctionName": {
     "Ref": "AppFunction"
    }
   },
   "Metadata": {
    "aws:cdk:path": "DemoStack/QueueMapping"
   }
  },
  "CDKMetadata": {
   "Type": "AWS::CDK::Metadata",
   "Properties": {
    "Analytics": "v2:deflate64:H4sIAAAAAAAA/yWMzQrCMBCEn8V7umrUF7CoJxGtd9kmW0l/NrXJtkjpu0vwNPMNfKNB73ewWeEUMmObrHUlzEVE0yicwmt22EFe8cO3pMIu1aOYhqJqsSstwpxXfBY20XlWecWnkTgWXgZDV+x7x+9F2S9j522Z7CeWLSkyOkFBRgYXv5fBS6/CJ6TxLiS0pK+bxF7iothbgjqsR61he4DNqg7OZYNwdB3B458/9pSVwMkAAAA="
   },
   "Metadata": {
    "aws:cdk:path": "DemoStack/CDKMetadata/Default"
   },
   "Condition": "CDKMetadataAvailable"
  }
 },
 "Outputs": {
  "BucketArn": {
   "Value": {
    "Fn::GetAtt": [
     "DataBucket",
     "Arn"
    ]
   }
  },
  "FunctionArn": {
   "Value": {
    "Fn::GetAtt": [
     "AppFunction",
     "Arn"
    ]
   }
  },
  "TableName": {
   "Value": {
    "Ref": "DataTable"
   }
  }
