{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CDK-synthesized template: Context describes the deployed resources whatever produced the template, so the queue and function are reported as missing a block and the topic's block as missing a rationale. The analytics record is not expected to carry Context and is not listed.",
  "Resources": {
    "OrderQueue": {
      "Type": "AWS::SQS::Queue",
      "Metadata": {
        "aws:cdk:path": "OrdersStack/OrderQueue/Resource"
      }
    },
    "OrderHandler": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "ZipFile": "exports.handler = async () => {};"
        },
        "Handler": "index.handler",
        "Role": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/order-handler"
        },
        "Runtime": "nodejs22.x"
      },
      "Metadata": {
        "aws:cdk:path": "OrdersStack/OrderHandler/Resource"
      }
    },
    "OrderTopic": {
      "Type": "AWS::SNS::Topic",
      "Metadata": {
        "aws:cdk:path": "OrdersStack/OrderTopic/Resource",
        "com.aws.cloudformation.Context": {
          "must": [
            "At least one subscriber"
          ]
        }
      }
    },
    "CDKMetadata": {
      "Type": "AWS::CDK::Metadata",
      "Properties": {
        "Analytics": "v2:deflate64:H4sIAAAAAAAA/yWMzQrCMBCEn8V7umrUF7CoJxGtd9kmW0l/NrXJtkjpu0vwNPMNfKNB73ewWeEUMmObrHUlzEVE0yicwmt22EFe8cO3pMIu1aOYhqJqsSstwpxXfBY20XlWecWnkTgWXgZDV+x7x+9F2S9j522Z7CeWLSkyOkFBRgYXv5fBS6/CJ6TxLiS0pK+bxF7iothbgjqsR61he4DNqg7OZYNwdB3B458/9pSVwMkAAAA="
      },
      "Metadata": {
        "aws:cdk:path": "OrdersStack/CDKMetadata/Default"
      }
    }
  }
}
