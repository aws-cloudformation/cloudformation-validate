{
  "Parameters": {
    "bucketListParam": { "Type": "String" }
  },
  "Resources": {
    "MyFunctionServiceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }]
        }
      }
    },
    "MyFunctionServiceRoleDefaultPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "MyFunctionServiceRoleDefaultPolicy",
        "Roles": [{ "Ref": "MyFunctionServiceRole" }],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Action": ["s3:GetObject*", "s3:GetBucket*", "s3:List*"],
            "Resource": { "Fn::Split": [",", { "Ref": "bucketListParam" }] }
          }]
        }
      }
    }
  }
}
