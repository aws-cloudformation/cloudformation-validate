{
  "Resources": {
    "Canary": {
      "Type": "AWS::Synthetics::Canary",
      "Properties": {
        "Name": "mycanary",
        "ArtifactS3Location": "s3://my-bucket/path",
        "ExecutionRoleArn": "arn:aws:iam::123456789012:role/my-canary-role",
        "RuntimeVersion": "syn-nodejs-puppeteer-7.0",
        "Schedule": {
          "Expression": "rate(5 minutes)"
        },
        "Code": {
          "Handler": "index.handler",
          "S3Bucket": "my-bucket",
          "S3Key": "code/canary.zip"
        },
        "ResourcesToReplicateTags": []
      }
    }
  }
}
