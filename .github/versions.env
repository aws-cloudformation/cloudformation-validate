# Tool versions shared by every workflow; loaded by .github/actions/load-configs.

APP_NAME=cloudformation-validate
WORKING_DIR=src

# Keep in sync with src/rust-toolchain.toml.
RUST_TOOLCHAIN=1.96.0

NODE_VERSION=22.x
PYTHON_VERSION=3.9
GO_VERSION=1.26

# Keep in sync with bindings-go/README.md and the uniffi pin in bindings-go/Cargo.toml.
UNIFFI_BINDGEN_GO_TAG=v0.7.1+v0.31.0

JAVA_VERSION=21
JAVA_DISTRIBUTION=corretto

KOTLIN_VERSION=2.4.0

# Keep in sync with bindings-jvm/build.gradle.kts.
DOKKA_VERSION=2.2.0

KTLINT_VERSION=1.8.0

GRADLE_VERSION=9.6.1

# Keep in sync with bindings-jvm/build.sh.
JNA_VERSION=5.19.1
GSON_VERSION=2.14.0

WASM_PACK_VERSION=0.15.0
CARGO_ABOUT_VERSION=0.9.1
CARGO_AUDIT_VERSION=0.22.2
CARGO_LLVM_COV_VERSION=0.8.7

# Keep in sync with bindings-jvm/tests/kotlin/build.gradle.kts.
JACOCO_VERSION=0.8.13
